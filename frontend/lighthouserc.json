{
  "ci": {
    "collect": {
      "startServerCommand": "npm run start",
      "startServerReadyPattern": "ready - started server on|Ready in|Local:|localhost:3000",
      "url": [
        "http://localhost:3000/",
        "http://localhost:3000/recipes",
        "http://localhost:3000/recipes/pho-bo-ha-noi",
        "http://localhost:3000/categories",
        "http://localhost:3000/categories/mon-viet"
      ],
      "numberOfRuns": 3,
      "settings": {
        "preset": "desktop"
      }
    },
    "assert": {
      "budgetsFile": "./budget.json",
      "assertions": {
        "categories:performance": ["warn", { "minScore": 0.9 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.9 }],
        "categories:seo": ["error", { "minScore": 0.95 }],
        "largest-contentful-paint": ["error", { "maxNumericValue": 2500 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }],
        "total-blocking-time": ["error", { "maxNumericValue": 200 }],
        "resource-summary:script:size": ["error", { "maxNumericValue": 204800 }]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}

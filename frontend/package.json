{
  "name": "@culinary-blog/web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build && node scripts/check-bundle-budget.mjs",
    "start": "next start --port 3000",
    "test": "node --test tests/*.test.mjs",
    "test:users:e2e": "node --test tests/admin-users.e2e.mjs",
    "test:audit:e2e": "node --test tests/audit-logging.e2e.mjs",
    "test:recipes:e2e": "node --test tests/recipe-lifecycle.e2e.mjs",
    "test:media:e2e": "node --test tests/media-upload.e2e.mjs",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "analyze": "node scripts/analyze-bundle.mjs",
    "budget:check": "node scripts/check-bundle-budget.mjs",
    "lighthouse:release": "node scripts/run-lighthouse-release.mjs",
    "generate:api": "openapi-typescript ../docs/specs/phase-0/openapi.v1.yaml --output src/lib/api/schema.d.ts",
    "generate:users-api": "node scripts/generate-admin-users-api.mjs",
    "test:components": "jest --runInBand",
    "test:completion:e2e": "node scripts/run-completion-e2e.mjs"
  },
  "engines": {
    "node": ">=22.23.3 <23"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@hookform/resolvers": "5.9.1",
    "@tanstack/react-query": "5.102.8",
    "axios": "1.20.0",
    "lucide-react": "1.45.0",
    "next": "15.5.28",
    "next-auth": "5.0.0-beta.32",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.87.0",
    "react-markdown": "10.1.0",
    "web-vitals": "4.2.4",
    "zod": "4.6.7",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@jest/globals": "30.5.2",
    "@next/bundle-analyzer": "^16.3.8",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "20.19.43",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "chrome-launcher": "1.2.2",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jest": "30.5.2",
    "jest-environment-jsdom": "30.5.2",
    "jsdom": "^29.1.1",
    "lighthouse": "13.5.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0"
  },
  "overrides": {
    "postcss": "8.5.28"
  }
}

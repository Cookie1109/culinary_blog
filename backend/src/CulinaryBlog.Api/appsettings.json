{
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Database": "Host=localhost;Port=5432;Database=culinary_blog;Username=culinary;Password=local-development-only",
    "Redis": "localhost:6379,abortConnect=false"
  },
  "ObjectStorage": {
    "Endpoint": "http://localhost:9000",
    "AccessKey": "culinary-local",
    "SecretKey": "local-development-only",
    "BucketName": "culinary-media"
  },
  "Jwt": {
    "Issuer": "CulinaryBlog.Api",
    "Audience": "CulinaryBlog.Web",
    "SigningKey": "local-development-only-change-this-key-before-shared-use",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Database": {
    "ApplyMigrationsOnStartup": false
  },
  "RateLimiting": {
    "GlobalPermitLimit": 100,
    "AuthPermitLimit": 10,
    "UploadPermitLimit": 5
  },
  "AdminSeed": {
    "Enabled": false,
    "DisplayName": "Administrator"
  },
  "Email": {
    "Enabled": false,
    "Host": "localhost",
    "Port": 1025,
    "FromAddress": "hello@culinaryblog.local",
    "FromName": "Culinary Blog"
  },
  "Seq": {
    "ServerUrl": ""
  },
  "Telemetry": {
    "OtlpEndpoint": ""
  }
}

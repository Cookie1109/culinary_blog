        },
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "targets": [
        {
          "expr": "sum by (job_type) (increase(culinary_media_jobs_completed_total[$__rate_interval]))",
          "legendFormat": "completed {{job_type}}",
          "refId": "A"
        },
        {
          "expr": "sum by (job_type) (increase(culinary_media_jobs_failed_total[$__rate_interval]))",
          "legendFormat": "failed {{job_type}}",
          "refId": "B"
        }
      ],
      "title": "Background jobs",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },

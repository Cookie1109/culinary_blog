          "refId": "A"
        },
        {
          "expr": "increase(recipe_published_total[$__rate_interval])",
          "legendFormat": "published",
          "refId": "B"
        },
        {
          "expr": "increase(recipe_unpublished_total[$__rate_interval])",
          "legendFormat": "unpublished",
          "refId": "C"
        }
      ],
      "title": "Recipe business events",
      "type": "timeseries"
    },

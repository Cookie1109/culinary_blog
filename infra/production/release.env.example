# Non-deployable example used to render and validate the production Compose model.
# Copy outside the repository, replace every example value from the approved
# manifest/secret store, and run scripts/release-gate.ps1 without -Template.
COMPOSE_PROJECT_NAME=culinary-blog-staging
PUBLIC_URL=https://culinary.example.test
ALLOWED_HOSTS=culinary.example.test
RELEASE_COMMIT_SHA=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
API_IMAGE=ghcr.io/example/culinary-blog-api@sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb
API_IMAGE_DIGEST=sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb
WEB_IMAGE=ghcr.io/example/culinary-blog-web@sha256:cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc
WEB_IMAGE_DIGEST=sha256:cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc
OTEL_IMAGE=otel/opentelemetry-collector-contrib:0.137.0@sha256:dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd
PROMETHEUS_IMAGE=prom/prometheus:v3.6.0@sha256:eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee
ALERTMANAGER_IMAGE=prom/alertmanager:v0.28.1@sha256:ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff
GRAFANA_IMAGE=grafana/grafana:12.2.0@sha256:1111111111111111111111111111111111111111111111111111111111111111
POSTGRES_DB=culinary_blog
POSTGRES_USER=culinary
POSTGRES_PASSWORD=example-secret-store-value
DATABASE_CONNECTION_STRING=Host=postgres;Port=5432;Database=culinary_blog;Username=culinary;Password=example-secret-store-value
REDIS_CONNECTION_STRING=redis:6379,abortConnect=false
MINIO_ROOT_USER=example-secret-store-user
MINIO_ROOT_PASSWORD=example-secret-store-value
MINIO_BUCKET=culinary-media
JWT_SIGNING_KEY=example-32-character-secret-store-value
AUTH_SECRET=example-32-character-auth-secret-value
REVALIDATION_SECRET=example-revalidation-secret-store-value
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
SMTP_HOST=smtp.example.test
SMTP_PORT=587
SMTP_FROM_ADDRESS=no-reply@example.test
SMTP_FROM_NAME=Culinary Blog
GRAFANA_ADMIN_USER=operations
GRAFANA_ADMIN_PASSWORD=example-secret-store-value
OPS_ALERT_WEBHOOK_URL_FILE=C:/deployment-secrets/operations-webhook-url
TLS_CERT_FILE=C:/deployment-secrets/tls.crt
TLS_KEY_FILE=C:/deployment-secrets/tls.key
POSTGRES_DATA_VOLUME=culinary-staging-postgres-data
REDIS_DATA_VOLUME=culinary-staging-redis-data
MINIO_DATA_VOLUME=culinary-staging-minio-data
PROMETHEUS_DATA_VOLUME=culinary-staging-prometheus-data
GRAFANA_DATA_VOLUME=culinary-staging-grafana-data
POSTGRES_BACKUP_VOLUME=culinary-staging-postgres-backups-independent
MINIO_BACKUP_VOLUME=culinary-staging-minio-backups-independent
MAINTENANCE_ENABLED=false
MAINTENANCE_MESSAGE=
MAINTENANCE_ANNOUNCED_AT_UTC=
MAINTENANCE_STARTS_AT_UTC=
MAINTENANCE_ENDS_AT_UTC=
